{
  "extends": ["@lonewolfyx/tsconfig/tsconfig.lib.json", "nitro/tsconfig"],
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "#/*": [
        "./src/types/*",
        "./types/*"
      ]
    },
    "resolveJsonModule": true,
    "types": ["node"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "declarationMap": false
  }
}
