{
  "manifest_version": 3,
  "name": "GitHub Unlimited Orgs",
  "version": "0.1.0",
  "description": "Expand all organizations on GitHub profiles with native hover cards.",
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:3000/*"]
}
