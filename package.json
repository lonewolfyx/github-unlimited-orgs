{
  "name": "github-unlimited-orgs",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "description": "Show all GitHub organizations for any user — API + browser extension + Tampermonkey script",
  "author": "lonewolfyx",
  "license": "MIT",
  "homepage": "https://github.com/lonewolfyx/github-unlimited-orgs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lonewolfyx/github-unlimited-orgs.git"
  },
  "bugs": "https://github.com/lonewolfyx/github-unlimited-orgs/issues",
  "keywords": [
    "github",
    "organizations"
  ],
  "scripts": {
    "build": "pnpm --filter @github-unlimited-orgs/chrome-extension --filter @github-unlimited-orgs/tampermonkey run build",
    "server:dev": "pnpm -F @github-unlimited-orgs/api run dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@lonewolfyx/tsconfig": "^0.0.6",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "jiti": "^2.7.0",
    "nitro": "3.0.260903-beta",
    "typescript": "^6.0.3"
  }
}
